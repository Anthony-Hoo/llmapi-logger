# Deployment-helper inputs only. audit-proxy does not read this file directly.
# Copy to .env.local, fill real values locally, and render a runtime YAML outside Git.
LLMAPI_DEPLOY_HOST=server.example.com
LLMAPI_DEPLOY_USER=deploy-user
LLMAPI_DEPLOY_PORT=3000
LLMAPI_PUBLIC_BASE_URL=https://api.example.com
LLMAPI_VALIDATION_API_KEY=replace-with-temporary-validation-key
LLMAPI_VALIDATION_MODEL=replace-with-model-id
LLMAPI_NEWAPI_ACCESS_TOKEN=replace-with-read-only-management-token
LLMAPI_NEWAPI_USER_ID=0
