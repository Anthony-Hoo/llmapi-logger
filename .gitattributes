* text=auto
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Skill package sources ship inside the agent packages; keep them LF on every
# checkout so the archives are identical whichever platform builds them.
skill/** text eol=lf
internal/agentdist/testdata/*.golden text eol=lf

# Frozen output of the removed legacy write path (internal/legacyoracle).
**/testdata/legacy-oracle/*.json text eol=lf
