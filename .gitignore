# Go build and test output
/bin/
*.exe
*.test
coverage.out

# Runtime data and secrets
/data/
*.db
*.db-shm
*.db-wal
*.key

# Local deployment values and rendered private configuration
/.env
/.env.*
!/.env.example
/configs/*.local.yaml
/configs/*.local.yml
/configs/*.private.yaml
/configs/*.private.yml
/configs/*.runtime.yaml
/configs/*.runtime.yml
/secrets/

# Frontend dependencies and local tooling
internal/web/frontend/node_modules/
internal/web/frontend/.pnpm-store/
.tools/

# Management UI build output. Produced by `pnpm build` or the Dockerfile
# web-build stage; only .gitkeep is tracked so `//go:embed all:dist` resolves in
# a fresh checkout.
/internal/web/dist/*
!/internal/web/dist/.gitkeep

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
